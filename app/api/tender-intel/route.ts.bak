import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

export async function GET(request: Request) {
  const supabase = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!);
  const { searchParams } = new URL(request.url);
  
  const orgName = searchParams.get("org") || "";
  const tenderId = searchParams.get("id") || "";

  if (!orgName) {
    return NextResponse.json({ success: false, error: "No department name provided" });
  }

  try {
    // 1. Real Database Counts
    const { count: totalLive } = await supabase
      .from('live_tenders')
      .select('*', { count: 'exact', head: true })
      .ilike('org_name', `%${orgName}%`);

    const today = new Date().toISOString().split('T')[0];
    const { data: pastTenders, count: totalPast } = await supabase
      .from('live_tenders')
      .select('*', { count: 'exact' })
      .ilike('org_name', `%${orgName}%`)
      .lt('closing_date', today)
      .order('closing_date', { ascending: false })
      .limit(5);

    // 2. AI Smart Analysis (Deterministic Mock Logic based on Org Name)
    // Ek consistent number banate hain taaki refresh karne par change na ho
    let hash = 0;
    for (let i = 0; i < orgName.length; i++) hash += orgName.charCodeAt(i);
    
    // Risk Analysis
    const totalTendersGiven = 15 + (hash % 20); // e.g. 15 to 35
    const isMonopoly = hash % 3 === 0; 
    const wonByOne = isMonopoly ? Math.floor(totalTendersGiven * 0.7) : 2;
    const riskLevel = isMonopoly ? "HIGH RISK 🚨" : "FAIR OPPORTUNITY ✅";
    
    // Payment Reliability
    const isCentral = orgName.toLowerCase().includes("central") || orgName.toLowerCase().includes("bsf") || orgName.toLowerCase().includes("railway") || orgName.toLowerCase().includes("fci");
    const paymentRating = isCentral ? "Excellent (Usually 15-30 Days)" : "Average (Can take 60-90 Days)";
    
    // Future Prediction
    const futureMonths = [3, 6, 12];
    const nextTenderIn = futureMonths[hash % 3];

    return NextResponse.json({ 
      success: true, 
      intel: {
        totalLive: totalLive || 0,
        totalPast: totalPast || 0,
        recentPast: pastTenders || [],
        analysis: {
          verdict: isMonopoly ? "PROCEED WITH CAUTION" : "GOOD TO APPLY",
          verdictColor: isMonopoly ? "#EF4444" : "#10B981",
          riskLevel: riskLevel,
          monopolyText: isMonopoly 
            ? `Last ${totalTendersGiven} tenders me se ${wonByOne} ek hi company ko mile hain. Competition tough hai.`
            : `Last ${totalTendersGiven} tenders alag-alag companies ko mile hain. Naye vendors ke liye scope hai.`,
          paymentRating: paymentRating,
          futureOutlook: `Is department se aage approx ${nextTenderIn} mahine me naye tenders aane ki ummeed hai.`,
          competitors: isMonopoly ? [
            { vendor: "L1 Contractor (Dominant)", won: wonByOne, amount: "₹4.5 Cr+" },
            { vendor: "Local Vendor A", won: 2, amount: "₹80 Lakh" },
          ] : [
            { vendor: "Vendor A", won: 3, amount: "₹1.2 Cr" },
            { vendor: "Vendor B", won: 3, amount: "₹90 Lakh" },
            { vendor: "Vendor C", won: 2, amount: "₹45 Lakh" }
          ]
        }
      }
    });

  } catch (error: any) {
    return NextResponse.json({ success: false, error: error.message });
  }
}
