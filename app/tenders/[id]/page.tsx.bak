"use client";

import { useEffect, useState } from "react";
import { useParams } from "next/navigation";
import Link from "next/link";
import BottomNav from "@/components/BottomNav";

const C = { bg: "#060B28", card: "#0E1533", text: "#fff", sub: "#A1A1AA", muted: "#71717A", accent: "#818CF8" };
const LINK = { textDecoration: "none", color: "#fff" };

export default function TenderDetailPage() {
  const params = useParams();
  const tenderId = params?.id as string;

  const [tender, setTender] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [tab, setTab] = useState("overview");

  const [intel, setIntel] = useState<any>(null);
  const [intelLoading, setIntelLoading] = useState(false);

  useEffect(() => {
    if (!tenderId) return;
    fetch(`/api/tender-detail?id=${encodeURIComponent(tenderId)}`)
      .then(r => r.json())
      .then(d => {
        if (d.success) setTender(d.tender);
        setLoading(false);
      })
      .catch(() => setLoading(false));
  }, [tenderId]);

  useEffect(() => {
    if (tab === "intel" && tender && !intel && !intelLoading) {
      setIntelLoading(true);
      fetch(`/api/tender-intel?org=${encodeURIComponent(tender.org_name || "")}&id=${tender.id}`)
        .then(r => r.json())
        .then(d => {
          if (d.success) setIntel(d.intel);
          setIntelLoading(false);
        })
        .catch(() => setIntelLoading(false));
    }
  }, [tab, tender, intel, intelLoading]);

  if (loading) return <div style={{ background: C.bg, minHeight: "100vh", color: C.text, padding: 20 }}>Loading...</div>;
  if (!tender) return <div style={{ background: C.bg, minHeight: "100vh", color: C.text, padding: 20 }}>Tender not found</div>;

  return (
    <div style={{ background: C.bg, minHeight: "100vh", color: C.text, paddingBottom: "80px" }}>
      
      {/* Header */}
      <div style={{ background: "linear-gradient(135deg, #4338CA 0%, #1E1B4B 100%)", padding: "24px 18px" }}>
        <Link href="/tenders" style={{ ...LINK, fontSize: 11, fontWeight: 800, display: "inline-block", marginBottom: 12, color: "#C7D2FE" }}>
          ← Back to Tenders
        </Link>
        <h1 style={{ fontSize: 18, fontWeight: 900, margin: "10px 0 0 0", lineHeight: 1.3 }}>
          {tender.title || "Tender Details"}
        </h1>
      </div>

      {/* Tabs */}
      <div style={{ display: "flex", padding: "18px 18px 0", gap: 8 }}>
        {["overview", "intel", "source"].map((t) => (
          <button 
            key={t} onClick={() => setTab(t)} 
            style={{ flex: 1, padding: "10px 0", background: tab === t ? C.card : "transparent", color: tab === t ? C.text : C.sub, border: "none", borderRadius: 8, fontWeight: 800, fontSize: 12, textTransform: "capitalize", cursor: "pointer" }}
          >
            {t}
          </button>
        ))}
      </div>

      {/* Content */}
      <div style={{ padding: "18px" }}>
        
        {tab === "overview" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
            <div style={{ background: C.card, padding: 16, borderRadius: 16 }}>
              <div style={{ fontSize: 10, color: C.muted, fontWeight: 800, textTransform: "uppercase", marginBottom: 12 }}>Tender Details</div>
              <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
                <span style={{ color: C.sub, fontSize: 12 }}>Closing Date</span>
                <span style={{ fontWeight: 700, fontSize: 12 }}>{tender.closing_date || "N/A"}</span>
              </div>
              <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
                <span style={{ color: C.sub, fontSize: 12 }}>Source</span>
                <span style={{ fontWeight: 700, fontSize: 12 }}>{tender.source || "N/A"}</span>
              </div>
              <div style={{ display: "flex", justifyContent: "space-between" }}>
                <span style={{ color: C.sub, fontSize: 12 }}>Value</span>
                <span style={{ fontWeight: 700, fontSize: 12 }}>{tender.value || "N/A"}</span>
              </div>
            </div>
          </div>
        )}

        {/* LIVE INTEL TAB */}
        {tab === "intel" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
            {intelLoading ? (
              <div style={{ textAlign: "center", padding: 20, color: C.sub }}>AI Brain Analysing...</div>
            ) : intel ? (
              <>
                {/* 1. AI Verdict Box */}
                <div style={{ background: `linear-gradient(135deg, ${intel.analysis.verdictColor}22 0%, ${C.card} 100%)`, border: `1px solid ${intel.analysis.verdictColor}55`, padding: 16, borderRadius: 16 }}>
                  <div style={{ fontSize: 12, color: C.sub, fontWeight: 800, textTransform: "uppercase", marginBottom: 4 }}>AI Consultant Verdict</div>
                  <div style={{ fontSize: 18, fontWeight: 900, color: intel.analysis.verdictColor }}>{intel.analysis.verdict}</div>
                  <div style={{ fontSize: 12, color: C.text, marginTop: 8, lineHeight: 1.4 }}>
                    <strong>Risk Analysis:</strong> {intel.analysis.monopolyText}
                  </div>
                </div>

                {/* 2. Department Kundli */}
                <div style={{ background: C.card, padding: 16, borderRadius: 16 }}>
                  <div style={{ fontSize: 14, fontWeight: 900, color: C.accent, marginBottom: 12 }}>📊 Department Kundli</div>
                  <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
                    <span style={{ color: C.sub, fontSize: 12 }}>Total Live Tenders</span>
                    <span style={{ fontWeight: 800, fontSize: 14, color: "#10B981" }}>{intel.totalLive}</span>
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
                    <span style={{ color: C.sub, fontSize: 12 }}>Past Tenders (Brain)</span>
                    <span style={{ fontWeight: 800, fontSize: 14, color: "#F59E0B" }}>{intel.totalPast}</span>
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between" }}>
                    <span style={{ color: C.sub, fontSize: 12 }}>Payment Reliability</span>
                    <span style={{ fontWeight: 800, fontSize: 12, color: "#60A5FA" }}>{intel.analysis.paymentRating}</span>
                  </div>
                </div>

                {/* 3. Competitors */}
                <div style={{ background: C.card, padding: 16, borderRadius: 16 }}>
                  <div style={{ fontSize: 14, fontWeight: 900, color: "#F59E0B", marginBottom: 12 }}>🏆 Top Competitors (History)</div>
                  {intel.analysis.competitors.map((c: any, i: number) => (
                    <div key={i} style={{ display: "flex", justifyContent: "space-between", borderBottom: i !== intel.analysis.competitors.length - 1 ? "1px solid rgba(255,255,255,0.05)" : "none", paddingBottom: 8, marginBottom: 8 }}>
                      <div style={{ fontSize: 12, fontWeight: 700 }}>{c.vendor}</div>
                      <div style={{ fontSize: 12, color: "#10B981" }}>{c.won} Wins • {c.amount}</div>
                    </div>
                  ))}
                </div>

                {/* 4. Future Outlook */}
                <div style={{ background: C.card, padding: 16, borderRadius: 16 }}>
                  <div style={{ fontSize: 14, fontWeight: 900, color: "#A78BFA", marginBottom: 8 }}>🔮 Future Outlook</div>
                  <div style={{ fontSize: 12, color: C.sub, lineHeight: 1.5 }}>
                    {intel.analysis.futureOutlook}
                  </div>
                </div>
              </>
            ) : (
              <div style={{ color: C.sub, fontSize: 12 }}>No intel found for this department.</div>
            )}
          </div>
        )}

        {tab === "source" && (
          <div style={{ background: C.card, padding: 16, borderRadius: 16 }}>
            <div style={{ fontSize: 12, fontWeight: 800, marginBottom: 8 }}>
              <a href={tender.source_url || "#"} target="_blank" rel="noopener noreferrer" style={{ color: C.accent, textDecoration: "none", wordBreak: "break-all" }}>
                {tender.source_url || "No source link available"}
              </a>
            </div>
          </div>
        )}
      </div>
      
      <BottomNav />
    </div>
  );
}
